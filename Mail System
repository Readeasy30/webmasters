from pydantic import BaseModel
import smtplib
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

# Define what data the endpoint expects from the web frontend
class EscalationPayload(BaseModel):
    client_email: str
    client_question: str
    business_type: str = "Not specified"

@app.post("/api/escalate")
async def send_escalation_alert(payload: EscalationPayload):
    # Your internal tracking setup
    sender_email = "your-verified-workspace-email@gmail.com"
    receiver_email = "sales-alerts@yourdomain.com" 
    # Use a secure App Password generated from your Google Account settings
    app_password = "your-16-character-app-password" 

    # Create the email layout structures
    msg = MIMEMultipart()
    msg['From'] = sender_email
    msg['To'] = receiver_email
    msg['Subject'] = f"🚨 TOP SHELF LEAD: Human Review Needed ({payload.business_type})"

    body = f"""
    The sales avatar has escalated a complex client question.
    
    💼 Business Type: {payload.business_type}
    📧 Contact Email: {payload.client_email}
    ❓ Question Asked: {payload.client_question}
    
    Action Required: Log into your dashboard and follow up manually within 24 hours.
    """
    msg.attach(MIMEText(body, 'plain'))

    try:
        # Connect securely using standard network encryption protocols
        server = smtplib.SMTP('://gmail.com', 587)
        server.starttls()
        server.login(sender_email, app_password)
        server.sendmail(sender_email, receiver_email, msg.as_string())
        server.quit()
        return {"status": "success", "message": "Alert sent to admin successfully"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
