<div id="onboarding-modal" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; background: white; padding: 25px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); z-index: 2000; font-family: sans-serif;">
    <h3 style="margin-top: 0; color: #111;">🚀 Secure Your Website Lease</h3>
    <p style="font-size: 14px; color: #555;">Fill out your business details below to initiate your Top Shelf layout setup.</p>
    
    <label style="font-size: 12px; font-weight: bold; display: block; margin-top: 10px;">BUSINESS NAME</label>
    <input type="text" id="biz-name" placeholder="e.g., Quick Locksmith" style="width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;">

    <label style="font-size: 12px; font-weight: bold; display: block; margin-top: 10px;">EMAIL ADDRESS</label>
    <input type="email" id="biz-email" placeholder="owner@mybusiness.com" style="width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;">

    <label style="font-size: 12px; font-weight: bold; display: block; margin-top: 10px;">CHOSEN PLAN</label>
    <select id="selected-plan" style="width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;">
        <option value="START">START Plan — $59/month</option>
        <option value="GROW">GROW Plan — $99/month</option>
        <option value="PRO">PRO Plan — $149/month</option>
    </select>

    <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
        <button onclick="closeOnboarding()" style="background: #eee; border: none; padding: 8px 14px; border-radius: 4px; cursor: pointer;">Cancel</button>
        <button onclick="submitOnboarding()" style="background: #22c55e; color: white; border: none; padding: 8px 14px; border-radius: 4px; cursor: pointer; font-weight: bold;">Submit</button>
    </div>
</div>

<!-- Dark Backdrop Layer -->
<div id="modal-backdrop" style="display: none; position: fixed; top:0; left:0; width:100vw; height:100vh; background: rgba(0,0,0,0.5); z-index: 1999;"></div>

<script>
    // Trigger this function when the avatar detects the user is ready to buy
    function openOnboarding(recommendedPlan = "START") {
        document.getElementById('selected-plan').value = recommendedPlan;
        document.getElementById('onboarding-modal').style.display = 'block';
        document.getElementById('modal-backdrop').style.display = 'block';
    }

    function closeOnboarding() {
        document.getElementById('onboarding-modal').style.display = 'none';
        document.getElementById('modal-backdrop').style.display = 'none';
    }

    async function submitOnboarding() {
        const bizName = document.getElementById('biz-name').value;
        const bizEmail = document.getElementById('biz-email').value;
        const chosenPlan = document.getElementById('selected-plan').value;

        if(!bizName || !bizEmail) {
            alert("Please fill in all fields.");
            return;
        }

        // Send data directly to your remote server API endpoint
        await fetch(`${BACKEND_URL}/api/onboard`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: bizName, email: bizEmail, plan: chosenPlan })
        });

        closeOnboarding();
        alert("Success! Your onboarding slot is secured. Check your email inbox shortly.");
    }
</script>
